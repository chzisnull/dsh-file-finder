{
  "name": "dsh-file-finder",
  "version": "0.2.0",
  "description": "Search a DSH workspace by file name or content, open results in DSH's native preview, and edit text files when needed.",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/search.test.mjs test/boot-safety.test.mjs test/ui-contract.test.mjs",
    "preview": "node preview/screenshot.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
