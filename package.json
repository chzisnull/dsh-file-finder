{
  "name": "dsh-file-finder",
  "version": "0.6.1",
  "description": "File finder for DSH: search by name or content, preview images, video, audio, PDF, HTML and Markdown, and edit text files with syntax colours, line numbers and in-file find.",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chzisnull/dsh-file-finder.git"
  },
  "homepage": "https://github.com/chzisnull/dsh-file-finder#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "file-search",
    "command-palette"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/search.test.mjs test/raw-route.test.mjs test/boot-safety.test.mjs test/ui-contract.test.mjs",
    "preview": "node preview/screenshot.mjs",
    "check:bot": "node preview/bot-check.mjs",
    "check:find": "node preview/find-check.mjs",
    "check:viewer": "node preview/viewer-check.mjs",
    "check:tokens": "node preview/token-check.mjs",
    "check:intel": "node preview/intel-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
