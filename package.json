{
  "name": "dsh-file-finder",
  "version": "0.3.0",
  "description": "File search palette for DSH: find workspace files by name or content, open them in DSH's native preview, and edit text files when needed.",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chzisnull/dsh-file-finder.git"
  },
  "homepage": "https://github.com/chzisnull/dsh-file-finder#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "file-search",
    "command-palette"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/search.test.mjs test/boot-safety.test.mjs test/ui-contract.test.mjs",
    "preview": "node preview/screenshot.mjs",
    "check:bot": "node preview/bot-check.mjs",
    "check:find": "node preview/find-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
